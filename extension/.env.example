VITE_API_BASE_URL=http://localhost:4000/api
# Chrome extension OAuth client — Google login (id_token)
VITE_GOOGLE_CLIENT_ID=your-extension-oauth-client-id.apps.googleusercontent.com
# Web OAuth client — Gmail send (must list https://YOUR_EXTENSION_ID.chromiumapp.org)
VITE_GOOGLE_GMAIL_CLIENT_ID=your-web-oauth-client-id.apps.googleusercontent.com
VITE_EXTENSION_ID=your-chrome-extension-idVITE_DEMO_MODE=true
VITE_LIT_NETWORK=datil-dev
VITE_LIT_API_KEY=your-lit-api-key
VITE_LIT_PKP_ID=your-lit-pkp-id
VITE_POLYGON_PRIVATE_KEY=your-polygon-private-key
VITE_POLYGON_PRIVATE_ADDRESS=your-polygon-wallet-address
VITE_POLYGON_PRIVATE_CHAIN_CODE=your-polygon-chain-code
VITE_POLYGON_PRIVATE_PUBLIC_KEY=your-polygon-public-key
VITE_POLYGON_PRIVATE_EXTENDED_KEY=your-polygon-extended-key
VITE_POLYGON_API_KEY=your-alchemy-polygon-api-key
