{
  "manifest_version": 3,
  "name": "SecureDocShare",
  "version": "1.0.0",
  "description": "Encrypt a document for one recipient and let only they decrypt it.",
  "action": {
    "default_popup": "index.html"
  },
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },
  "oauth2": {
    "client_id": "387608086587-doqkofeg562lv3cs8qtvd50jc1ej4m5s.apps.googleusercontent.com",
    "scopes": [
      "openid",
      "email",
      "profile"
    ]
  },
  "permissions": [
    "identity",
    "storage",
    "downloads",
    "tabs",
    "windows"
  ],
  "host_permissions": [
    "https://*.litprotocol.com/*",
    "https://oauth2.googleapis.com/*",
    "https://api.devnet.solana.com/*",
    "https://*.solana.com/*",
    "https://*.g.alchemy.com/*",
    "http://localhost:4000/*",
    "https://mail.google.com/*"
  ],
  "key": ""
}
