PORT=4000
MONGODB_URI=mongodb://localhost:27017/secure-doc-share
JWT_SECRET=change-this-to-a-long-random-string
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com

# Optional SMTP for password-reset OTP emails.
# If omitted, OTP codes are printed in the server console during development.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
# Port 587 (STARTTLS): SMTP_SECURE=false
# Port 465 (SSL):       SMTP_SECURE=true
SMTP_SECURE=false
SMTP_USER=your-smtp-user
SMTP_PASS=your-smtp-password
SMTP_FROM=SecureDocShare <noreply@example.com>
