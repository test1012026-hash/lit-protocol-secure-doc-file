PORT=4000
# Public base URL where the server (and reset-password page) is reachable.
# Vercel example: https://your-app.vercel.app
# Used to build the password reset link that is emailed to users.
APP_URL=http://localhost:4000
# Use MongoDB Atlas for Vercel (allow Network Access 0.0.0.0/0).
MONGODB_URI=mongodb://localhost:27017/secure-doc-share
JWT_SECRET=change-this-to-a-long-random-string
# Used by extension "Continue with Google" (ID token audience).
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com

# Gmail API OAuth (Web client) — used to send mail. Not the same as a refresh token.
GOOGLE_GMAIL_CLIENT_ID=your-gmail-oauth-client-id.apps.googleusercontent.com
GOOGLE_GMAIL_CLIENT_SECRET=GOCSPX-your-client-secret
GOOGLE_GMAIL_REDIRECT_URI=http://localhost:4000/auth/google/callback
# Real refresh token looks like 1//0g... — get it with:
#   node scripts/get-gmail-refresh-token.js
GOOGLE_REFRESH_TOKEN=
# Must be the same Google account you authorized above.
GMAIL_SENDER=you@gmail.com

# Set true to skip Lit requirements on send (base64 storage for testing).
DEMO_MODE=true
