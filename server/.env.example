PORT=4000
# Public base URL where the server (reset-password + open-extension) is reachable.
# Vercel example: https://your-app.vercel.app
# Email "Open SecureDocShare" links to ${APP_URL}/open-extension
APP_URL=http://localhost:4000
MONGODB_URI=mongodb://localhost:27017/secure-doc-share
JWT_SECRET=change-this-to-a-long-random-string

# Chrome extension OAuth client — same ID as extension manifest oauth2.client_id.
# Used to verify Google id_tokens from "Continue with Google" in the extension.
GOOGLE_CLIENT_ID=your-extension-oauth-client-id.apps.googleusercontent.com

# Web OAuth client — server-side Gmail connect + optional password-reset mailbox only.
# Authorized redirect URIs (Web application client):
#   http://localhost:4000/api/auth/gmail/callback
#   https://your-server.vercel.app/api/auth/gmail/callback
# Do NOT put chromiumapp.org here; extension login uses the Chrome extension client above.
GOOGLE_GMAIL_CLIENT_ID=your-web-oauth-client-id.apps.googleusercontent.com
GOOGLE_GMAIL_CLIENT_SECRET=GOCSPX-your-client-secret
GOOGLE_GMAIL_REDIRECT_URI=http://localhost:4000/api/auth/gmail/callback

# Optional shared mailbox for password-reset emails (not used for file sends):
GOOGLE_REFRESH_TOKEN=
GMAIL_SENDER=you@gmail.com

# Chrome extension ID from chrome://extensions (must match for email → extension open)
EXTENSION_ID=gljjkimecepnndocjchjabdmiogdapeb

DEMO_MODE=true
