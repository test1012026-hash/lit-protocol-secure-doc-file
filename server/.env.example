PORT=4000

APP_URL=http://localhost:4000
MONGODB_URI=mongodb://localhost:27017/secure-doc-share
EMAIL_ENCRYPTION_KEY=change-this-to-a-long-random-string
JWT_SECRET=change-this-to-a-long-random-string
# Admin panel cookie (optional)
# COOKIE_SECURE=false
# CORS_ORIGINS=http://localhost:5174,https://admin.example.com,https://admin2.example.com
# ADMIN_APP_URL=http://localhost:5174

GOOGLE_CLIENT_ID=your-extension-oauth-client-id.apps.googleusercontent.com
GOOGLE_GMAIL_CLIENT_ID=your-web-oauth-client-id.apps.googleusercontent.com
GOOGLE_GMAIL_CLIENT_SECRET=GOCSPX-your-client-secret
GOOGLE_GMAIL_REDIRECT_URI=http://localhost:4000/api/auth/gmail/callback
GOOGLE_REFRESH_TOKEN=
GMAIL_SENDER=you@gmail.com

# Admin panel SSO (Google / Microsoft / Yahoo) — one client key per provider.
# Strategy 1 (default): register each admin origin callback on the same client:
#   {origin}/api/admin/auth/oauth/google/callback
#   {origin}/api/admin/auth/oauth/microsoft/callback
#   {origin}/api/admin/auth/oauth/yahoo/callback
# ADMIN_OAUTH_CALLBACK_MODE=per_origin
# ADMIN_OAUTH_RETURN_ORIGINS=http://localhost:5174,https://admin.example.com,https://admin2.example.com
# Optional dedicated Google web client (falls back to GOOGLE_GMAIL_*):
# ADMIN_OAUTH_GOOGLE_CLIENT_ID=
# ADMIN_OAUTH_GOOGLE_CLIENT_SECRET=
# ADMIN_OAUTH_MICROSOFT_CLIENT_ID=
# ADMIN_OAUTH_MICROSOFT_CLIENT_SECRET=
# ADMIN_OAUTH_MICROSOFT_TENANT=common
# ADMIN_OAUTH_YAHOO_CLIENT_ID=
# ADMIN_OAUTH_YAHOO_CLIENT_SECRET=
# Hub mode (single API redirect URI for many domains):
# ADMIN_OAUTH_CALLBACK_MODE=hub

# Outlook add-in / user OAuth (same IdP clients as admin SSO above).
# Register these redirect URIs on each provider console:
#   {APP_URL}/api/auth/oauth/google/callback
#   {APP_URL}/api/auth/oauth/microsoft/callback
#   {APP_URL}/api/auth/oauth/yahoo/callback
# Example local: http://localhost:4000/api/auth/oauth/google/callback
# OUTLOOK_OAUTH_RETURN_ORIGINS=https://localhost:3000
# ADDIN_HTTPS_ORIGIN=https://localhost:3000

EXTENSION_ID=gljjkimecepnndocjchjabdmiogdapeb
# Must match VITE_LIT_ACTION_ID in the extension (passphrase for wrapped private keys).
LIT_ACTION_ID=your-lit-action-id

